# Vercel Postgres
POSTGRES_URL=

# Protects /admin and /api/admin/*
ADMIN_PASSWORD=

# Strong random secret for signing admin sessions (recommended, separate from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Canonical site URL (server-side config; no NEXT_PUBLIC prefix needed)
SITE_URL=https://controluce.blog

# Optional: search engine ownership verification (codes from Search Console / Bing Webmaster Tools)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: IndexNow key (16-64 letters, digits or dashes). Notifies Bing & co on publish/update/delete.
INDEXNOW_KEY=
